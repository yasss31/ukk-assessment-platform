# UKK Assessment Platform - Environment Configuration Example
# Copy this file to .env and adjust variables accordingly

# Security & Secrets
SECRET_KEY=ukk-production-secret-key-change-this-to-a-very-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Super Admin Account
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=adminukk2026
SUPER_ADMIN_NAME="Administrator Penilaian"

# Google Sheets Integration
GOOGLE_SPREADSHEET_ID=1Ri7F8T7YTQdr7F71aslfVpIfYrSva_F0dmtbT5tBJW8
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
# Optional base64 encoded service account json (for serverless environments)
GOOGLE_SERVICE_ACCOUNT_BASE64=
STORAGE_MODE=sheets

# AWS Auto Play Defaults
DEFAULT_AUTO_PLAY_ENABLED=false
DEFAULT_AUTO_PLAY_INTERVAL_MINUTES=180
MAX_AUTO_PLAY_RETRY=3

# Server & Network
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000,*

# Cloudflare Tunnel Token (Optional, for public domain on VPS)
CLOUDFLARE_TUNNEL_TOKEN=
